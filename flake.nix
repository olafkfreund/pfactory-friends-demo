  # GENERATED by RFC-0005 nix_provisioner from the task contract environment
  # manifest. Committed as a deliverable so build (AIFactory) and verify
  # (TFactory) share one flake.lock and cannot drift. Edit the manifest, not this.
  #
  # swift toolchain added to satisfy the `swift-unit` verification gate, which
  # runs `swift test` in lanes/swift-core. The prior manifest provisioned only
  # kotlin/gradle/jdk21, so the gate failed with `swift: command not found`
  # (see GATE_FAILURES.md). This is a missing-dependency-in-manifest defect, not
  # a code defect. The provisioning below — swift + swiftpm plus the
  # Dispatch/Foundation/XCTest runtime libraries on LD_LIBRARY_PATH — is exactly
  # the recipe measured working on Linux in lanes/swift-core/NOTES.md, and the
  # LinuxMain.swift + XCTestManifests.swift convention it relies on already
  # exists in that lane.
  description = "Factory per-task toolchain (RFC-0005 Tier A)";
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/567a49d1913ce81ac6e9582e3553dd90a955875f";
  outputs = { self, nixpkgs }:
    let
      system = "x86_64-linux";
      pkgs = import nixpkgs { inherit system; };
      # libdispatch/Foundation/XCTest must be on the runtime library path before
      # SwiftPM even reads Package.swift (NOTES.md, step 2).
      swiftRuntimeLibs = [
        pkgs.swiftPackages.Dispatch
        pkgs.swiftPackages.Foundation
        pkgs.swiftPackages.XCTest
      ];
    in {
      devShells.${system}.default = pkgs.mkShell {
        packages = [
          pkgs.kotlin
          pkgs.gradle
          pkgs.jdk21
          pkgs.swiftPackages.swift
          pkgs.swiftPackages.swiftpm
        ] ++ swiftRuntimeLibs;
        shellHook = ''
          export LD_LIBRARY_PATH="${pkgs.lib.makeLibraryPath swiftRuntimeLibs}''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        '';
      };
    };
}
