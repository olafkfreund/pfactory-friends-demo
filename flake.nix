{
  # GENERATED by RFC-0005 nix_provisioner from the task contract environment
  # manifest. Committed as a deliverable so build (AIFactory) and verify
  # (TFactory) share one flake.lock and cannot drift. Edit the manifest, not this.
  #
  # QA-fix (session 1): the `swift-unit` verification gate runs `swift test`
  # against lanes/swift-core, but this manifest previously provisioned only the
  # Kotlin toolchain, so the gate died with `bash: line 1: swift: command not
  # found` (a missing-toolchain failure, not a test failure). The Swift library
  # lane DOES verify on Linux — see lanes/swift-core/NOTES.md — it just needs the
  # compiler/driver (`swift`) and SwiftPM (`swiftpm`) on PATH plus the runtime
  # libraries (Dispatch/Foundation/XCTest) on LD_LIBRARY_PATH before SwiftPM can
  # load Package.swift. Provisioning it here lets the gate run the real tests
  # instead of failing on a missing binary. Kotlin provisioning is unchanged.
  description = "Factory per-task toolchain (RFC-0005 Tier A)";
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/567a49d1913ce81ac6e9582e3553dd90a955875f";
  outputs = { self, nixpkgs }:
    let
      system = "x86_64-linux";
      pkgs = import nixpkgs { inherit system; };
      # Swift runtime libraries. The SwiftPM manifest is compiled and then
      # executed, so these must be on LD_LIBRARY_PATH before Package.swift is
      # even read (lanes/swift-core/NOTES.md, steps 2-3).
      swiftLibs = [
        pkgs.swiftPackages.Dispatch
        pkgs.swiftPackages.Foundation
        pkgs.swiftPackages.XCTest
      ];
    in {
      devShells.${system}.default = pkgs.mkShell {
        packages = [
          pkgs.kotlin
          pkgs.gradle
          pkgs.jdk21
          pkgs.swiftPackages.swift
          pkgs.swiftPackages.swiftpm
        ] ++ swiftLibs;
        # `swift` driver and `swift-test` are separate; both come from the
        # swiftPackages set above. Put the runtime libs on the library path so
        # the SwiftPM manifest loader (and the built test binary) can resolve
        # libdispatch/Foundation/XCTest at runtime.
        shellHook = ''
          export LD_LIBRARY_PATH="${pkgs.lib.makeLibraryPath swiftLibs}''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        '';
      };
    };
}
